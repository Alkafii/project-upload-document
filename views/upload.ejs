                            <div class="form-group col-md-6 mb-0 pl-3">
                                <label>Hasil Uji Fungsionalitas</label>
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" name="Hasil_Uji_Fungsi" id="dokumen">
                                    <label class="custom-file-label text-truncate" for="dokumen" data-browse="🗀" style="padding-right: 50px;">Choose file</label>
                                </div>
                                <small class="form-text text-muted">File formats: PDF, DOCX, XLSX.</small>
                            </div>
                        </div>
                        <div class="row no-gutters mb-3">
                            <div class="col-12 pr-2">
                                <button type="submit" class="btn btn-primary btn-block">Upload</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form> 
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>
    <script>
        $(document).ready(function () {
            const errorBox = $('#clientErrorBox');
            const errorText = $('#errorMessageText');

            const MAX_FILE_SIZE = 2 * 1024 * 1024;
            const allowedExtensions = ['pdf', 'doc', 'docx', 'xls', 'xlsx'];

            function toggleError(message = '') {
            errorText.text(message);
            errorBox.toggleClass('d-none', !message).toggleClass('show', !!message);
            if (message) window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            function validateFile(file) {
            const ext = file.name.split('.').pop().toLowerCase();
            if (!allowedExtensions.includes(ext)) return 'Format file tidak didukung! Gunakan PDF, DOC, DOCX, XLS, atau XLSX.';
            if (file.size > MAX_FILE_SIZE) return 'Ukuran file terlalu besar! Maksimal dokumen adalah 2 MB.';
            return null;
            }

            function processFiles(input) {
            const files = Array.from(input.files);
            if (!files.length) return;

            for (const file of files) {
                const error = validateFile(file);
                if (error) {
                input.value = '';
                $(input).next('.custom-file-label').removeClass('selected').text('Choose file');
                return toggleError(error);
                }
            }

            $(input)
                .next('.custom-file-label')
                .addClass('selected')
                .text(files.length > 1 ? `${files.length} files selected` : files[0].name);

            toggleError();
            }

            $('.custom-file-input').on('change', function () {
            processFiles(this);
            });

            $(document).on('dragover drop', (e) => e.preventDefault());

            $('.custom-file')
            .on('dragenter dragover', function (e) {
                e.preventDefault();
                $(this).addClass('drag-over');
            })
            .on('dragleave drop', function (e) {
                e.preventDefault();
                $(this).removeClass('drag-over');

                if (e.type === 'drop') {
                const input = $(this).find('.custom-file-input')[0];
                const files = e.originalEvent.dataTransfer.files;
                if (!input || !files.length) return;

                const dt = new DataTransfer();
                Array.from(files).forEach((file) => dt.items.add(file));
                input.files = dt.files;
                processFiles(input);
                }
            });

            $('form').on('submit', function (e) {
            const files = $('.custom-file-input')
                .toArray()
                .flatMap((i) => Array.from(i.files));

            if (!files.length) {
                e.preventDefault();
                return toggleError('Silakan unggah minimal satu dokumen sebelum melanjutkan.');
            }

            for (const file of files) {
                const error = validateFile(file);
                if (error) {
                e.preventDefault();
                return toggleError(error);
                }
            }
            });

            $('.custom-file-input').attr('accept', '.pdf,.doc,.docx,.xls,.xlsx');

            window.toggleApiFields = function (selectedValue) {
            const isVA = selectedValue === 'Virtual Account SNAP';
            const isQRIS = selectedValue === 'QRIS MPM SNAP';

            $('#VA').toggle(isVA);
            $('#vaType').prop('required', isVA).val(isVA ? $('#vaType').val() : '');
            $('#QRIS').toggle(isQRIS);

            if (isQRIS) $('#textOff, #textOn').collapse('hide');
            };
        });
    </script>
</body>
</html>
