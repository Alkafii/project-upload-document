                    <div id="clientErrorBox" class="alert alert-danger p-2 text-center alert-dismissible fade show <%= !errorMessage ? 'd-none' : '' %>" role="alert">
                        <small id="errorMessageText"><%= errorMessage || '' %></small>
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close" style="outline: none;">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                <hr class="mb-4">
                <div class="mb-3">
                    <label>Name of institution<label class="font-weight-bold text-danger">*</label></label>
                    <input type="text" class="form-control" id="projectName" name="institutionName" placeholder="Integration with.." value="" required
                        oninput="this.value = this.value.replace(/[\/|\\]/g, '')">
                </div>
                <div class="mb-4">
                    <label for="integrationType">API Name <span class="font-weight-bold text-danger">*</span></label>
                    <select name="integrationType" id="integrationType" class="form-control text-secondary" required onchange="toggleApiFields(this.value)">
                        <option value="" disabled selected>Select</option>
                        <option value="Virtual Account SNAP">Virtual Account SNAP</option>
                        <option value="QRIS MPM SNAP">QRIS MPM SNAP</option>
                    </select>
                </div>
                <div class="mb-4" id="VA" style="display: none;">
                    <label for="integrationType">Virtual Account Type <span class="font-weight-bold text-danger">*</span></label>
                    <select name="vaType" id="vaType" class="form-control text-secondary"
                        onchange="
                            if(this.value === 'Off Us') { $('#textOff').collapse('show'); $('#textOn').collapse('hide'); }
                            else if(this.value === 'On Us') { $('#textOn').collapse('show'); $('#textOff').collapse('hide'); }
                            else { $('#textOff').collapse('hide'); $('#textOn').collapse('hide'); }
                        ">
                        <option value="" disabled selected>Select</option>
                        <option value="Off Us">Off Us</option>
                        <option value="On Us">On Us</option>
                    </select>
                </div>
